# ==========================================
# Epochlypse Research - Safe Repository .gitignore
# Prevents accidental leak of credentials, environment variables,
# OS metadata, IDE configs, logs, and private brand assets.
# ==========================================

# --- Environment & Secret Credentials ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
*secret*
*credential*
credentials.json
auth.json
token.json
id_rsa
id_ed25519

# --- Operating System & Filesystem Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Internal Assets & Partner Guidelines ---
# Raw internal packages & guideline docs (web-ready assets are inside assets/)
Brand Usage Guidelines/
Inception Badges/
*.ai
*.psd
*.eps
*.tiff
*.raw

# --- IDEs, Editors & Tooling ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
.directory

# --- Logs, Diagnostics & Temp ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.cache
.cache/
temp/
tmp/

# --- Node / Build Artifacts (if added in future) ---
node_modules/
.npm/
.pnpm-store/
dist/
build/
.parcel-cache/
.next/
.nuxt/
